function ensureSuiteAudio(){
  if(!suiteAudioCtx){
    var AC = window.AudioContext || window.webkitAudioContext;
    suiteAudioCtx = new AC();
  }
  if(suiteAudioCtx.state === "suspended") suiteAudioCtx.resume();
}

function playElectroBassNote(midi, durSec){
  ensureSuiteAudio();
  var now = suiteAudioCtx.currentTime;
  var freq = 440 * Math.pow(2, (midi - 69) / 12);
  var osc1 = suiteAudioCtx.createOscillator();
  var osc2 = suiteAudioCtx.createOscillator();
  var flt = suiteAudioCtx.createBiquadFilter();
  var g = suiteAudioCtx.createGain();
  osc1.type = "sawtooth"; osc1.frequency.setValueAtTime(freq, now);
  osc2.type = "square";   osc2.frequency.setValueAtTime(freq * 0.5, now);
  flt.type = "lowpass";   flt.Q.value = 6.5;
  flt.frequency.setValueAtTime(3200, now);
  flt.frequency.exponentialRampToValueAtTime(420, now + (durSec || 0.22));
  g.gain.setValueAtTime(0.001, now);
  g.gain.linearRampToValueAtTime(0.32, now + 0.005);
  g.gain.exponentialRampToValueAtTime(0.001, now + (durSec || 0.24));
  osc1.connect(flt); osc2.connect(flt); flt.connect(g); g.connect(suiteAudioCtx.destination);
  osc1.start(now); osc1.stop(now + (durSec || 0.25));
  osc2.start(now); osc2.stop(now + (durSec || 0.25));
}

