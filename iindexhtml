function readRootDomainCookie(){
try{
var m=document.cookie.match(/(?:^|;\s*)ffh_ui=([^;]+)/);
if(m&&m[1])return JSON.parse(decodeURIComponent(m[1]));
}catch(e){}
return null;
}
function writeRootDomainCookie(obj){
try{
var val=encodeURIComponent(JSON.stringify(obj));
document.cookie="ffh_ui="+val+"; domain=.forefronthawk.com; path=/; max-age=31536000; SameSite=Lax";
document.cookie="ffh_ui="+val+"; path=/; max-age=31536000; SameSite=Lax";
}catch(e){}
}
function readUrlHashState(){
try{
if(location.hash&&location.hash.indexOf("ffh=")>-1){
var part=location.hash.split("ffh=")[1].split("&")[0];
return JSON.parse(decodeURIComponent(part));
